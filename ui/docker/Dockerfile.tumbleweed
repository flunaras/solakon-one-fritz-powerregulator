# Build image for openSUSE Tumbleweed — solakon-one-fritz-powerregulator-ui (x86_64, native)
#
# Dependencies fetched via CMake FetchContent at configure time:
#   QtKeychain 0.14.3 (platform secret-store bindings; header-only build deps below)
#
# System libraries: Qt6 (Widgets, Network, Charts), libsecret (Secret Service backend
# used by QtKeychain on Linux), git (needed by FetchContent).

FROM opensuse/tumbleweed:latest

LABEL org.opencontainers.image.title="solakon-one-fritz-powerregulator-ui-builder-tumbleweed"
LABEL org.opencontainers.image.description="Build environment for solakon-one-fritz-powerregulator-ui on openSUSE Tumbleweed (x86_64)"

# ── All build dependencies ────────────────────────────────────────────────────
# The base Tumbleweed image ships busybox-gawk, which conflicts with the real
# gawk package that rpm-build requires.  Remove the stub and install everything
# in a single zypper transaction so all gawk-dependent packages stay consistent.
RUN zypper --non-interactive remove busybox-gawk || true && \
    zypper --non-interactive install --no-recommends \
        cmake \
        ninja \
        gcc-c++ \
        make \
        git \
        pkg-config \
        gzip \
        tar \
        which \
        gawk \
        rpm-build \
        qt6-base-devel \
        qt6-charts-devel \
        qt6-tools-devel \
        libsecret-devel

# ── Ensure the build directory exists and is writable ─────────────────────────
RUN mkdir -p /build && chmod 777 /build

WORKDIR /src
